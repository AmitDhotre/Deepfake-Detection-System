# Copy this to .env for local dev overrides, or set the same variable
# name in your hosting provider's dashboard for production.
#
# Local dev (optional — defaults to http://localhost:8000 if unset):
# VITE_API_BASE=http://localhost:8000
#
# Production (required — set this in Vercel/Netlify's env var settings):
# VITE_API_BASE=https://your-backend-url.onrender.com